ta-next-font=\"size-adjust\" rel=\"preconnect\" href=\"/\" crossorigin=\"anonymous\"/><link rel=\"preload\" href=\"/_next/static/css/559f3cc741d6c5f3.css\" as=\"style\"/><link href=\"https://fonts.googleapis.com/css2?family=EB+Garamond&amp;display=swap\" rel=\"stylesheet\" data-next-head=\"\"/><script type=\"application/ld+json\" data-next-head=\"\">{\"@context\":\"https://schema.org\",\"@type\":\"LegalService\",\"name\":\"M.E ESONANJOR and Company\",\"url\":\"https://m-e-esonanjor-and-company.vercel.app\",\"logo\":\"https://m-e-esonanjor-and-company.vercel.app/logo.png\",\"description\":\"WHERE LEGAL STRATEGY IS PRECISION-BUILT.\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Lagos\",\"addressCountry\":\"Nigeria\",\"postalCode\":\"101001\"},\"sameAs\":[\"https://twitter.com/M.E ESONANJOR and Company\",\"https://www.linkedin.com/company/m-e-esonanjor-and-company\",\"https://www.facebook.com/m-e-esonanjor-and-company\"]}</script><link rel=\"stylesheet\" href=\"/_next/static/css/559f3cc741d6c5f3.css\" data-n-g=\"\"/><noscript data-n-css=\"\"></noscript><script defer=\"\" noModule=\"\" src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\"></script><script src=\"/_next/static/chunks/webpack-06833fb297db238c.js\" defer=\"\"></script><script src=\"/_next/static/chunks/framework-86ad0b4475c628a3.js\" defer=\"\"></script><script src=\"/_next/static/chunks/main-017b46be1b747284.js\" defer=\"\"></script><script src=\"/_next/static/chunks/pages/_app-97f6a6cf27a46b5f.js\" defer=\"\"></script><script src=\"/_next/static/chunks/311-65e3d4591f3dc1f3.js\" defer=\"\"></script><script src=\"/_next/static/chunks/606-45605b30cc1f5f27.js\" defer=\"\"></script><script src=\"/_next/static/chunks/727-02c45049c9645fd6.js\" defer=\"\"></script><script src=\"/_next/static/chunks/pages/blog/%5Bslug%5D-02876a39f5531461.js\" defer=\"\"></script><script src=\"/_next/static/C8UV40mM35vZv8dfZSkeF/_buildManifest.js\" defer=\"\"></script><script src=\"/_next/static/C8UV40mM35vZv8dfZSkeF/_ssgManifest.js\" defer=\"\"></script></head><body><link rel=\"preload\" as=\"image\" href=\"/logo.png\"/><div id=\"__next\"><div><header class=\"bg-gray-800 sticky top-0 z-20 text-white py-6 px-8 shadow-lg\"><div class=\"max-w-7xl mx-auto flex justify-between items-center\"><a class=\"flex items-center space-x-3\" href=\"/\"><img src=\"/logo.png\" alt=\"Honoredge Legal Practice Logo\" class=\"h-14 w-auto\"/></a><nav class=\"hidden md:flex space-x-8\"><a class=\"relative group font-semibold tracking-wide\" href=\"/about\">About<span class=\"absolute left-0 -bottom-1 w-0 h-0.5 bg-white transition-all group-hover:w-full\"></span></a><a class=\"relative group font-semibold tracking-wide\" href=\"/attorneys\">Attorneys<span class=\"absolute left-0 -bottom-1 w-0 h-0.5 bg-white transition-all group-hover:w-full\"></span></a><a class=\"relative group font-semibold tracking-wide\" href=\"/#practice-areas\">Practice Areas<span class=\"absolute left-0 -bottom-1 w-0 h-0.5 bg-white transition-all group-hover:w-full\"></span></a><a class=\"relative group font-semibold tracking-wide\" href=\"/blog\">Blog<span class=\"absolute left-0 -bottom-1 w-0 h-0.5 bg-white transition-all group-hover:w-full\"></span></a><a class=\"relative group font-semibold tracking-wide\" href=\"/contact\">Contact<span class=\"absolute left-0 -bottom-1 w-0 h-0.5 bg-white transition-all group-hover:w-full\"></span></a></nav><button class=\"md:hidden text-white focus:outline-none\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu\" aria-hidden=\"true\"><line x1=\"4\" x2=\"20\" y1=\"12\" y2=\"12\"></line><line x1=\"4\" x2=\"20\" y1=\"6\" y2=\"6\"></line><line x1=\"4\" x2=\"20\" y1=\"18\" y2=\"18\"></line></svg></button></div></header><main><div class=\"max-w-3xl mx-auto px-4 py-10\"><h1 class=\"text-4xl font-bold mb-4\">Real Estate Laws and Their Loopholes in Nigeria</h1><img alt=\"Real Estate Laws and Their Loopholes in Nigeria\" loading=\"lazy\" width=\"1200\" height=\"600\" decoding=\"async\" data-nimg=\"1\" class=\"rounded-lg\" style=\"color:transparent\" srcSet=\"/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F7h99z6jk%2Fproduction%2F4ddba50a538a27356325737eb9c696ca6552f4a1-9728x6656.jpg&amp;w=1200&amp;q=75 1x, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F7h99z6jk%2Fproduction%2F4ddba50a538a27356325737eb9c696ca6552f4a1-9728x6656.jpg&amp;w=3840&amp;q=75 2x\" src=\"/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F7h99z6jk%2Fproduction%2F4ddba50a538a27356325737eb9c696ca6552f4a1-9728x6656.jpg&amp;w=3840&amp;q=75\"/><div class=\"mt-6\"><p class=\"my-2 text-gray-700 leading-relaxed\"><strong class=\"font-semibold\">Introduction</strong></p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\">Nigeria&#x27;s real estate sector represents a significant portion of the nation&#x27;s economy, with urban centers like Lagos, Abuja, and Port Harcourt experiencing rapid development and substantial property investments. However, the legal framework governing real estate transactions in Nigeria contains numerous ambiguities and loopholes that continue to create challenges for investors, developers, and everyday citizens. This article examines these laws, their implementation challenges, and the various legal gaps that are often exploited.</p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\"><strong class=\"font-semibold\">Land Use Act: The Foundation with Fundamental Flaws</strong></p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\">The Land Use Act of 1978 remains the cornerstone of Nigeria&#x27;s real estate legal framework, vesting all land within a state&#x27;s territory in the governor who holds it in trust for the people. While this law aimed to streamline land administration and make land more accessible, several loopholes have emerged over the decades:</p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\">The Act requires governor&#x27;s consent for any property transfer, creating bureaucratic bottlenecks that significantly delay legitimate transactions. This requirement has spawned an informal market of &quot;holding&quot; agreements where parties conduct transactions without officially transferring title—creating legal uncertainty and potential for future disputes.</p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\">Additionally, the Act&#x27;s compensation provisions for land acquisition have proven inadequate, often failing to reflect market values. This discrepancy has led to widespread litigation and resistance to government acquisition projects, with savvy landowners exploiting procedural technicalities to demand higher compensation or delay development projects.</p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\"><strong class=\"font-semibold\">Unclear Title Registration Systems</strong></p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\">Nigeria&#x27;s fragmented title registration system varies by state, creating inconsistencies that undermine security of tenure. In many states, multiple registries exist with overlapping jurisdictions, allowing unscrupulous individuals to:</p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\">- Register the same property multiple times across different systems</p><p class=\"my-2 text-gray-700 leading-relaxed\">- Create fraudulent documentation that appears legitimate</p><p class=\"my-2 text-gray-700 leading-relaxed\">- Exploit gaps between customary land rights and statutory registration</p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\">Lagos State&#x27;s introduction of electronic Certificate of Occupancy (e-C of O) represents progress, but most states still operate manual systems vulnerable to manipulation and corruption. The lack of a unified national land registry system creates opportunities for double sales and title fraud.</p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\"><strong class=\"font-semibold\">Tenancy Law Enforcement Gaps</strong></p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\">Various states have enacted tenancy laws to regulate landlord-tenant relationships, but enforcement mechanisms remain weak. In Lagos, the Tenancy Law of 2011 prohibits landlords from collecting more than one year&#x27;s rent in advance for residential properties. However, this provision is routinely violated due to:</p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\">- Insufficient monitoring mechanisms</p><p class=\"my-2 text-gray-700 leading-relaxed\">- Lack of penalties that effectively deter violations</p><p class=\"my-2 text-gray-700 leading-relaxed\">- Market pressures that force tenants to accept illegal terms</p><p class=\"my-2 text-gray-700 leading-relaxed\">- Limited access to affordable legal remedies</p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\">Landlords often circumvent these regulations by structuring agreements as &quot;service contracts&quot; rather than traditional leases, or by demanding substantial &quot;caution deposits&quot; that effectively function as additional rent payments.</p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\"><strong class=\"font-semibold\">Mortgage and Foreclosure Challenges</strong></p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\">Nigeria&#x27;s mortgage laws contain significant ambiguities that impede the development of a robust mortgage market. The Mortgage Institutions Act and various state mortgage laws establish basic frameworks, but lenders face substantial challenges in enforcing security interests when borrowers default.</p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\">Courts have frequently interpreted foreclosure provisions narrowly, requiring lenders to pursue lengthy judicial processes before recovering secured properties. This legal uncertainty contributes to Nigeria&#x27;s high mortgage interest rates and stringent lending requirements, limiting access to housing finance.</p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\">Savvy borrowers exploit procedural technicalities to delay foreclosure proceedings, sometimes for years, while continuing to occupy or derive income from the property. This legal maneuvering reduces the value of real estate as collateral and undermines the entire mortgage system.</p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\"><strong class=\"font-semibold\">Urban Planning and Development Control Loopholes</strong></p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\">Nigeria&#x27;s urban planning laws and building codes exist on paper but suffer from inconsistent enforcement. Developers routinely exploit several loopholes:</p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\">- Initiating construction without permits, then seeking retroactive approval</p><p class=\"my-2 text-gray-700 leading-relaxed\">- Obtaining approvals for one purpose, then altering building use without authorization</p><p class=\"my-2 text-gray-700 leading-relaxed\">- Bribing enforcement officials to overlook violations</p><p class=\"my-2 text-gray-700 leading-relaxed\">- Exploiting jurisdictional conflicts between state and local authorities</p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\">These practices have led to haphazard development, unsafe structures, and infrastructure overload in many urban areas. Lagos State&#x27;s demolition of illegal structures represents attempts at enforcement, but these efforts often come too late, after significant investments have already been made.</p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\"><strong class=\"font-semibold\">Tax Evasion Through Real Estate</strong></p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\">Nigeria&#x27;s real estate sector serves as a significant avenue for tax evasion due to valuation ambiguities and enforcement challenges. Property values are frequently understated in official documentation to minimize:</p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\">- Capital gains tax on property transfers</p><p class=\"my-2 text-gray-700 leading-relaxed\">- Annual property taxes</p><p class=\"my-2 text-gray-700 leading-relaxed\">- Stamp duties on conveyancing documents</p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\">The absence of a comprehensive property valuation database makes it difficult for tax authorities to detect undervaluation. Additionally, many high-value properties are held through shell companies or nominees, obscuring beneficial ownership and complicating tax enforcement.</p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\"><strong class=\"font-semibold\">Foreign Investment Restrictions and Workarounds</strong></p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\">While Nigeria welcomes foreign investment in real estate, certain restrictions exist that are routinely circumvented. Foreign entities cannot directly acquire land but must establish Nigerian companies to do so. However, loopholes include:</p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\">- Creating Nigerian shell companies with nominee directors</p><p class=\"my-2 text-gray-700 leading-relaxed\">- Utilizing irrevocable powers of attorney that effectively transfer control without changing title</p><p class=\"my-2 text-gray-700 leading-relaxed\">- Structuring investments as long-term leases rather than outright purchases</p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\">These arrangements create legal uncertainty and potential vulnerabilities for foreign investors, while also allowing circumvention of regulatory oversight designed to protect national interests.</p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\"><strong class=\"font-semibold\">Addressing the Gaps: Reform Initiatives</strong></p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\">Recent reform efforts have attempted to address these loopholes:</p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\">1. The proposed Land Use Act Amendment Bill seeks to streamline consent requirements and improve compensation frameworks</p><p class=\"my-2 text-gray-700 leading-relaxed\">2. The Foreclosure Law in Lagos aims to simplify mortgage enforcement procedures</p><p class=\"my-2 text-gray-700 leading-relaxed\">3. Digital land registries are being implemented in several states to reduce fraud</p><p class=\"my-2 text-gray-700 leading-relaxed\">4. Real Estate Developers Association of Nigeria (REDAN) Bill proposes regulation of developers to reduce fraudulent practices</p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\">However, these reforms face significant political and institutional resistance, as many powerful interests benefit from the status quo.</p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\"><strong class=\"font-semibold\">Conclusion</strong></p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\">Nigeria&#x27;s real estate laws contain numerous loopholes that undermine security of tenure, enable fraud, complicate financing, and frustrate urban planning efforts. While these gaps create opportunities for the well-connected and legally sophisticated, they impose substantial costs on the broader economy through reduced investment, higher transaction costs, and suboptimal land utilization.</p><p class=\"my-2 text-gray-700 leading-relaxed\"></p><p class=\"my-2 text-gray-700 leading-relaxed\">Comprehensive reform requires not just legislative changes but also institutional strengthening, technological modernization, and cultural shifts in how real estate transactions are conducted. Until such reforms are implemented, investors and participants in Nigeria&#x27;s real estate market must navigate these legal gaps with careful due diligence and expert guidance to protect their interests.</p></div><div class=\"flex items-center mt-6 mb-10 space-x-4\"><div><h3 class=\"text-lg font-semibold\">Ebuzhafe Annora Ogunsanya</h3></div></div></div></main><footer class=\"bg-gray-800 text-white py-16 px-6 md:px-20\"><div class=\"max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-12\"><div class=\"flex flex-col items-center md:items-start\"><img alt=\" M.E ESONANJOR and Company Logo\" loading=\"lazy\" width=\"100\" height=\"100\" decoding=\"async\" data-nimg=\"1\" class=\"object-contain\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2F_next%2Fstatic%2Fmedia%2Flogo.6cd93c1f.png&amp;w=128&amp;q=75 1x, /_next/image?url=%2F_next%2Fstatic%2Fmedia%2Flogo.6cd93c1f.png&amp;w=256&amp;q=75 2x\" src=\"/_next/image?url=%2F_next%2Fstatic%2Fmedia%2Flogo.6cd93c1f.png&amp;w=256&amp;q=75\"/><h3 class=\"mt-4 text-2xl font-bold font-garamond tracking-wider leading-tight text-center md:text-left uppercase\">M.E ESONANJOR and Company</h3></div><div class=\"flex flex-col space-y-2\"><h4 class=\"text-2xl font-garamond mb-4\">Contact Details</h4><address class=\"not-italic text-lg\">34 Oduduwa Way,<br/>GRA, Ikeja,<br/>Lagos, Nigeria.</address><p class=\"mt-4 text-lg\">Phone:<!-- --> <a href=\"tel:+2347048828395\" class=\"hover:underline\">+234 704 882 8395</a><br/><a href=\"tel:+2348033818650\" class=\"hover:underline\">+234 803 381 8650</a></p><p class=\"text-lg\">Email:<!-- --> <a href=\"mailto:attorney@mesonanjor.com\" class=\"hover:underline\">attorney@mesonanjor.com</a></p></div><div class=\"flex flex-col space-y-2\"><h4 class=\"text-2xl font-garamond mb-4\">Office Hours</h4><div class=\"text-lg\"><p>Monday to Friday: 8:00 AM – 5:30 PM</p><p>Saturday: Closed</p><p>Sunday: Closed</p></div></div></div><div class=\"max-w-7xl mx-auto mt-12 border-t border-gray-500 pt-8 text-center md:text-left\"><div class=\"flex flex-col md:flex-row md:items-center md:justify-between\"><div><h4 class=\"text-xl font-garamond mb-4 md:mb-2\">Follow Us</h4><div class=\"flex justify-center md:justify-start space-x-6 text-2xl\"><a href=\"https://www.facebook.com/share/16LqV19wid/?mibextid=wwXIfr\" aria-label=\"Facebook\" class=\"hover:text-gray-300 focus:text-gray-300\"><i class=\"fab fa-facebook-f\"></i></a><a href=\"https://www.linkedin.com/in/m-e-esonanjor-and-company-1b4035390\" aria-label=\"LinkedIn\" class=\"hover:text-gray-300 focus:text-gray-300\"><i class=\"fab fa-linkedin\"></i></a><a href=\"https://www.instagram.com/m.e_esonanjor.co?igsh=cnExdW1waTJlYmxk&amp;utm_source=qr\" aria-label=\"Instagram\" class=\"hover:text-gray-300 focus:text-gray-300\"><i class=\"fab fa-instagram\"></i></a></div></div><div class=\"mt-6 md:mt-0 text-sm \">© <!-- -->2026<!-- --> M.E ESONANJOR AND COMPANY. All rights reserved.</div></div></div></footer></div></div><script id=\"__NEXT_DATA__\" type=\"application/json\">{\"props\":{\"pageProps\":{\"post\":{\"_id\":\"9bea43c5-9d5c-4c12-830c-aacf6053ff60\",\"author\":{\"bio\":null,\"image\":null,\"name\":\"Ebuzhafe Annora Ogunsanya\"},\"body\":[{\"_key\":\"1d698fb34e4d\",\"_type\":\"block\",\"children\":[{\"_key\":\"6f4bb18e11e0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Introduction\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f442f6168039\",\"_type\":\"block\",\"children\":[{\"_key\":\"bedb1dcc1a98\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c47385b1b1e2\",\"_type\":\"block\",\"children\":[{\"_key\":\"0dc7d1c087ce\",\"_type\":\"span\",\"marks\":[],\"text\":\"Nigeria's real estate sector represents a significant portion of the nation's economy, with urban centers like Lagos, Abuja, and Port Harcourt experiencing rapid development and substantial property investments. However, the legal framework governing real estate transactions in Nigeria contains numerous ambiguities and loopholes that continue to create challenges for investors, developers, and everyday citizens. This article examines these laws, their implementation challenges, and the various legal gaps that are often exploited.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"9c2ec3cbcb39\",\"_type\":\"block\",\"children\":[{\"_key\":\"e973885cc856\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"4ee1bbe08d37\",\"_type\":\"block\",\"children\":[{\"_key\":\"6bfe04c97286\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Land Use Act: The Foundation with Fundamental Flaws\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"9a57d0f42784\",\"_type\":\"block\",\"children\":[{\"_key\":\"7459f0074969\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"89e3d2fedf97\",\"_type\":\"block\",\"children\":[{\"_key\":\"ecb5028c3840\",\"_type\":\"span\",\"marks\":[],\"text\":\"The Land Use Act of 1978 remains the cornerstone of Nigeria's real estate legal framework, vesting all land within a state's territory in the governor who holds it in trust for the people. While this law aimed to streamline land administration and make land more accessible, several loopholes have emerged over the decades:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"241dfa26c6f2\",\"_type\":\"block\",\"children\":[{\"_key\":\"b348245f0384\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"1179d9cc8e7a\",\"_type\":\"block\",\"children\":[{\"_key\":\"86927200416b\",\"_type\":\"span\",\"marks\":[],\"text\":\"The Act requires governor's consent for any property transfer, creating bureaucratic bottlenecks that significantly delay legitimate transactions. This requirement has spawned an informal market of \\\"holding\\\" agreements where parties conduct transactions without officially transferring title—creating legal uncertainty and potential for future disputes.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"445f9c31e57b\",\"_type\":\"block\",\"children\":[{\"_key\":\"1bc194f2a53d\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"6a91d1157aa6\",\"_type\":\"block\",\"children\":[{\"_key\":\"185c31e12ce6\",\"_type\":\"span\",\"marks\":[],\"text\":\"Additionally, the Act's compensation provisions for land acquisition have proven inadequate, often failing to reflect market values. This discrepancy has led to widespread litigation and resistance to government acquisition projects, with savvy landowners exploiting procedural technicalities to demand higher compensation or delay development projects.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"e7e03f3c0cc4\",\"_type\":\"block\",\"children\":[{\"_key\":\"bd8491c113aa\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"8235d7dddb3f\",\"_type\":\"block\",\"children\":[{\"_key\":\"3442cd5379f6\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Unclear Title Registration Systems\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a0219d18cfdc\",\"_type\":\"block\",\"children\":[{\"_key\":\"19e7c2b8d7ca\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"4e302136a9b5\",\"_type\":\"block\",\"children\":[{\"_key\":\"e57a77f05f7a\",\"_type\":\"span\",\"marks\":[],\"text\":\"Nigeria's fragmented title registration system varies by state, creating inconsistencies that undermine security of tenure. In many states, multiple registries exist with overlapping jurisdictions, allowing unscrupulous individuals to:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"b7b4a087e696\",\"_type\":\"block\",\"children\":[{\"_key\":\"9c25c1719c11\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d7279bf6bad0\",\"_type\":\"block\",\"children\":[{\"_key\":\"0fe906dfb333\",\"_type\":\"span\",\"marks\":[],\"text\":\"- Register the same property multiple times across different systems\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"9591cc25a390\",\"_type\":\"block\",\"children\":[{\"_key\":\"ddb16f1fe90c\",\"_type\":\"span\",\"marks\":[],\"text\":\"- Create fraudulent documentation that appears legitimate\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"50a1d65d5c1a\",\"_type\":\"block\",\"children\":[{\"_key\":\"8526fe64d34d\",\"_type\":\"span\",\"marks\":[],\"text\":\"- Exploit gaps between customary land rights and statutory registration\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"13f15d0b264d\",\"_type\":\"block\",\"children\":[{\"_key\":\"cf2a9a2bd9db\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f1e7b829767f\",\"_type\":\"block\",\"children\":[{\"_key\":\"1e572628ac08\",\"_type\":\"span\",\"marks\":[],\"text\":\"Lagos State's introduction of electronic Certificate of Occupancy (e-C of O) represents progress, but most states still operate manual systems vulnerable to manipulation and corruption. The lack of a unified national land registry system creates opportunities for double sales and title fraud.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a6edf73c92ee\",\"_type\":\"block\",\"children\":[{\"_key\":\"d9b9f86dfc33\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"0061ac21057a\",\"_type\":\"block\",\"children\":[{\"_key\":\"8eed6b4abad2\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Tenancy Law Enforcement Gaps\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f61aa87144da\",\"_type\":\"block\",\"children\":[{\"_key\":\"3003a641ca33\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"95383d5ed05a\",\"_type\":\"block\",\"children\":[{\"_key\":\"3b10dba80aed\",\"_type\":\"span\",\"marks\":[],\"text\":\"Various states have enacted tenancy laws to regulate landlord-tenant relationships, but enforcement mechanisms remain weak. In Lagos, the Tenancy Law of 2011 prohibits landlords from collecting more than one year's rent in advance for residential properties. However, this provision is routinely violated due to:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"bec1b40355ee\",\"_type\":\"block\",\"children\":[{\"_key\":\"8ca035ccaa4e\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"516fa1bf8da8\",\"_type\":\"block\",\"children\":[{\"_key\":\"fa644d6f523e\",\"_type\":\"span\",\"marks\":[],\"text\":\"- Insufficient monitoring mechanisms\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f205a3385243\",\"_type\":\"block\",\"children\":[{\"_key\":\"a1878df6bdc6\",\"_type\":\"span\",\"marks\":[],\"text\":\"- Lack of penalties that effectively deter violations\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"5f111c556b00\",\"_type\":\"block\",\"children\":[{\"_key\":\"320c1b053e66\",\"_type\":\"span\",\"marks\":[],\"text\":\"- Market pressures that force tenants to accept illegal terms\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d1f038c97d8c\",\"_type\":\"block\",\"children\":[{\"_key\":\"7addaee474be\",\"_type\":\"span\",\"marks\":[],\"text\":\"- Limited access to affordable legal remedies\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"4a37bd828dc5\",\"_type\":\"block\",\"children\":[{\"_key\":\"a3746ded8ce5\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"fed2008fb341\",\"_type\":\"block\",\"children\":[{\"_key\":\"45a05ba8ce85\",\"_type\":\"span\",\"marks\":[],\"text\":\"Landlords often circumvent these regulations by structuring agreements as \\\"service contracts\\\" rather than traditional leases, or by demanding substantial \\\"caution deposits\\\" that effectively function as additional rent payments.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"cc7c4d3bccb9\",\"_type\":\"block\",\"children\":[{\"_key\":\"025bf1abaabc\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"9bde3b1810ae\",\"_type\":\"block\",\"children\":[{\"_key\":\"5c3c6592f6b0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Mortgage and Foreclosure Challenges\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d3ac439d8130\",\"_type\":\"block\",\"children\":[{\"_key\":\"44f9447d0b22\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"99db32ca2c39\",\"_type\":\"block\",\"children\":[{\"_key\":\"7d2afcf68e70\",\"_type\":\"span\",\"marks\":[],\"text\":\"Nigeria's mortgage laws contain significant ambiguities that impede the development of a robust mortgage market. The Mortgage Institutions Act and various state mortgage laws establish basic frameworks, but lenders face substantial challenges in enforcing security interests when borrowers default.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"9b9a0a91c8e8\",\"_type\":\"block\",\"children\":[{\"_key\":\"8c369386b56b\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"9a5d12d499d1\",\"_type\":\"block\",\"children\":[{\"_key\":\"87c9f3ccff1f\",\"_type\":\"span\",\"marks\":[],\"text\":\"Courts have frequently interpreted foreclosure provisions narrowly, requiring lenders to pursue lengthy judicial processes before recovering secured properties. This legal uncertainty contributes to Nigeria's high mortgage interest rates and stringent lending requirements, limiting access to housing finance.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"65e768d30d23\",\"_type\":\"block\",\"children\":[{\"_key\":\"571740280a50\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"e69a61e7ed10\",\"_type\":\"block\",\"children\":[{\"_key\":\"6ac6e4de53e3\",\"_type\":\"span\",\"marks\":[],\"text\":\"Savvy borrowers exploit procedural technicalities to delay foreclosure proceedings, sometimes for years, while continuing to occupy or derive income from the property. This legal maneuvering reduces the value of real estate as collateral and undermines the entire mortgage system.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"2a761e6c3614\",\"_type\":\"block\",\"children\":[{\"_key\":\"e93e808e378e\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"899c214d3235\",\"_type\":\"block\",\"children\":[{\"_key\":\"892d7e427943\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Urban Planning and Development Control Loopholes\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"cea220070e00\",\"_type\":\"block\",\"children\":[{\"_key\":\"639cc2ddf464\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c0db9bec0ef9\",\"_type\":\"block\",\"children\":[{\"_key\":\"3db9d2f8e464\",\"_type\":\"span\",\"marks\":[],\"text\":\"Nigeria's urban planning laws and building codes exist on paper but suffer from inconsistent enforcement. Developers routinely exploit several loopholes:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"7d449b739d3b\",\"_type\":\"block\",\"children\":[{\"_key\":\"25c2f52f5383\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"3ec8cdb4a2e9\",\"_type\":\"block\",\"children\":[{\"_key\":\"4164bb55018e\",\"_type\":\"span\",\"marks\":[],\"text\":\"- Initiating construction without permits, then seeking retroactive approval\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"89406c19602b\",\"_type\":\"block\",\"children\":[{\"_key\":\"7e39a0caf0b3\",\"_type\":\"span\",\"marks\":[],\"text\":\"- Obtaining approvals for one purpose, then altering building use without authorization\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"2c6b8f7accc4\",\"_type\":\"block\",\"children\":[{\"_key\":\"762dd66a898a\",\"_type\":\"span\",\"marks\":[],\"text\":\"- Bribing enforcement officials to overlook violations\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"b603a7f61f23\",\"_type\":\"block\",\"children\":[{\"_key\":\"b0dc49ed8971\",\"_type\":\"span\",\"marks\":[],\"text\":\"- Exploiting jurisdictional conflicts between state and local authorities\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"12a881db7b23\",\"_type\":\"block\",\"children\":[{\"_key\":\"6946cec7b9e7\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"2cf1694ba991\",\"_type\":\"block\",\"children\":[{\"_key\":\"ead1f5e2ea9c\",\"_type\":\"span\",\"marks\":[],\"text\":\"These practices have led to haphazard development, unsafe structures, and infrastructure overload in many urban areas. Lagos State's demolition of illegal structures represents attempts at enforcement, but these efforts often come too late, after significant investments have already been made.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"12c1dd8b152a\",\"_type\":\"block\",\"children\":[{\"_key\":\"025900562e10\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d2ff43ce6a9f\",\"_type\":\"block\",\"children\":[{\"_key\":\"b08d8f3081fc\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Tax Evasion Through Real Estate\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"1c618a737b73\",\"_type\":\"block\",\"children\":[{\"_key\":\"c6bc49a55c67\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"7e247791ee98\",\"_type\":\"block\",\"children\":[{\"_key\":\"40f542f44f6e\",\"_type\":\"span\",\"marks\":[],\"text\":\"Nigeria's real estate sector serves as a significant avenue for tax evasion due to valuation ambiguities and enforcement challenges. Property values are frequently understated in official documentation to minimize:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"af3cbb24d939\",\"_type\":\"block\",\"children\":[{\"_key\":\"18e9a69364dc\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"136f2bea3cd1\",\"_type\":\"block\",\"children\":[{\"_key\":\"155ed95135e2\",\"_type\":\"span\",\"marks\":[],\"text\":\"- Capital gains tax on property transfers\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"5cbc49692d87\",\"_type\":\"block\",\"children\":[{\"_key\":\"af8b29833345\",\"_type\":\"span\",\"marks\":[],\"text\":\"- Annual property taxes\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"92f9bd94dc20\",\"_type\":\"block\",\"children\":[{\"_key\":\"ee72b50158c4\",\"_type\":\"span\",\"marks\":[],\"text\":\"- Stamp duties on conveyancing documents\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"5b824bdc8552\",\"_type\":\"block\",\"children\":[{\"_key\":\"fcf5fc28e103\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a385ae4655de\",\"_type\":\"block\",\"children\":[{\"_key\":\"39e36e135d03\",\"_type\":\"span\",\"marks\":[],\"text\":\"The absence of a comprehensive property valuation database makes it difficult for tax authorities to detect undervaluation. Additionally, many high-value properties are held through shell companies or nominees, obscuring beneficial ownership and complicating tax enforcement.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"de6d92b021c4\",\"_type\":\"block\",\"children\":[{\"_key\":\"1d49a5adc9d6\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"02fde8cebaa9\",\"_type\":\"block\",\"children\":[{\"_key\":\"e4da4cb69f85\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Foreign Investment Restrictions and Workarounds\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"b7a52a3e3ebd\",\"_type\":\"block\",\"children\":[{\"_key\":\"283e1a07bed2\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"7d10340b588a\",\"_type\":\"block\",\"children\":[{\"_key\":\"208b4b03cd8f\",\"_type\":\"span\",\"marks\":[],\"text\":\"While Nigeria welcomes foreign investment in real estate, certain restrictions exist that are routinely circumvented. Foreign entities cannot directly acquire land but must establish Nigerian companies to do so. However, loopholes include:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"9e9617a6ddb4\",\"_type\":\"block\",\"children\":[{\"_key\":\"61d9289538e7\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d202f55ff033\",\"_type\":\"block\",\"children\":[{\"_key\":\"64afef960dec\",\"_type\":\"span\",\"marks\":[],\"text\":\"- Creating Nigerian shell companies with nominee directors\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"dc8aeafa7e84\",\"_type\":\"block\",\"children\":[{\"_key\":\"361da5e32caf\",\"_type\":\"span\",\"marks\":[],\"text\":\"- Utilizing irrevocable powers of attorney that effectively transfer control without changing title\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d9d25bb57bdf\",\"_type\":\"block\",\"children\":[{\"_key\":\"3494df5e823b\",\"_type\":\"span\",\"marks\":[],\"text\":\"- Structuring investments as long-term leases rather than outright purchases\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"583905b94039\",\"_type\":\"block\",\"children\":[{\"_key\":\"4faab993eff7\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"8d0d4b61df83\",\"_type\":\"block\",\"children\":[{\"_key\":\"89e92217f208\",\"_type\":\"span\",\"marks\":[],\"text\":\"These arrangements create legal uncertainty and potential vulnerabilities for foreign investors, while also allowing circumvention of regulatory oversight designed to protect national interests.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"bbe9dc93a34f\",\"_type\":\"block\",\"children\":[{\"_key\":\"24f83f90c2ce\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"4bdfd0c29612\",\"_type\":\"block\",\"children\":[{\"_key\":\"38543abd83b2\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Addressing the Gaps: Reform Initiatives\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"6b308f906a4d\",\"_type\":\"block\",\"children\":[{\"_key\":\"2766e60e0478\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d1cdd0e0aac2\",\"_type\":\"block\",\"children\":[{\"_key\":\"ff0fc8e595fb\",\"_type\":\"span\",\"marks\":[],\"text\":\"Recent reform efforts have attempted to address these loopholes:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"3693566b24c1\",\"_type\":\"block\",\"children\":[{\"_key\":\"d41cabcbee41\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a527fe04366a\",\"_type\":\"block\",\"children\":[{\"_key\":\"8ed3c8af8160\",\"_type\":\"span\",\"marks\":[],\"text\":\"1. The proposed Land Use Act Amendment Bill seeks to streamline consent requirements and improve compensation frameworks\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"348105b90a7e\",\"_type\":\"block\",\"children\":[{\"_key\":\"558117e972b9\",\"_type\":\"span\",\"marks\":[],\"text\":\"2. The Foreclosure Law in Lagos aims to simplify mortgage enforcement procedures\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"861a72f560cc\",\"_type\":\"block\",\"children\":[{\"_key\":\"e83630cf61a3\",\"_type\":\"span\",\"marks\":[],\"text\":\"3. Digital land registries are being implemented in several states to reduce fraud\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c7b0483cafab\",\"_type\":\"block\",\"children\":[{\"_key\":\"2d52bb80c46f\",\"_type\":\"span\",\"marks\":[],\"text\":\"4. Real Estate Developers Association of Nigeria (REDAN) Bill proposes regulation of developers to reduce fraudulent practices\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a066115aa46a\",\"_type\":\"block\",\"children\":[{\"_key\":\"386d0ea1dbb2\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"ad3e9d228b26\",\"_type\":\"block\",\"children\":[{\"_key\":\"658125278dad\",\"_type\":\"span\",\"marks\":[],\"text\":\"However, these reforms face significant political and institutional resistance, as many powerful interests benefit from the status quo.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"74d631f7b519\",\"_type\":\"block\",\"children\":[{\"_key\":\"9e233c28c1bb\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"739c70ca3902\",\"_type\":\"block\",\"children\":[{\"_key\":\"99feb7cb7bc2\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Conclusion\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f5e8eed4ad43\",\"_type\":\"block\",\"children\":[{\"_key\":\"a0f024697223\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"98af38b2fe3f\",\"_type\":\"block\",\"children\":[{\"_key\":\"9484e7530221\",\"_type\":\"span\",\"marks\":[],\"text\":\"Nigeria's real estate laws contain numerous loopholes that undermine security of tenure, enable fraud, complicate financing, and frustrate urban planning efforts. While these gaps create opportunities for the well-connected and legally sophisticated, they impose substantial costs on the broader economy through reduced investment, higher transaction costs, and suboptimal land utilization.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"5604b15ac37d\",\"_type\":\"block\",\"children\":[{\"_key\":\"bad6d93a0a4c\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"cef90d3e5164\",\"_type\":\"block\",\"children\":[{\"_key\":\"1e8a82a859e4\",\"_type\":\"span\",\"marks\":[],\"text\":\"Comprehensive reform requires not just legislative changes but also institutional strengthening, technological modernization, and cultural shifts in how real estate transactions are conducted. Until such reforms are implemented, investors and participants in Nigeria's real estate market must navigate these legal gaps with careful due diligence and expert guidance to protect their interests.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"comments\":[],\"mainImage\":{\"_type\":\"image\",\"alt\":\"real-estate-laws-and-their-loopholes-in-nigeria\",\"asset\":{\"_ref\":\"image-4ddba50a538a27356325737eb9c696ca6552f4a1-9728x6656-jpg\",\"_type\":\"reference\"}},\"title\":\"Real Estate Laws and Their Loopholes in Nigeria\"}},\"__N_SSG\":true},\"page\":\"/blog/[slug]\",\"query\":{\"slug\":\"real-estate-laws-and-their-loopholes-in-nigeria\"},\"buildId\":\"C8UV40mM35vZv8dfZSkeF\",\"isFallback\":false,\"gsp\":true,\"scriptLoader\":[]}</script></body></html>","json":{"pageProps":{"post":{"_id":"9bea43c5-9d5c-4c12-830c-aacf6053ff60","author":{"bio":null,"image":null,"name":"Ebuzhafe Annora Ogunsanya"},"body":[{"_key":"1d698fb34e4d","_type":"block","children":[{"_key":"6f4bb18e11e0","_type":"span","marks":["strong"],"text":"Introduction"}],"markDefs":[],"style":"normal"},{"_key":"f442f6168039","_type":"block","children":[{"_key":"bedb1dcc1a98","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"c47385b1b1e2","_type":"block","children":[{"_key":"0dc7d1c087ce","_type":"span","marks":[],"text":"Nigeria's real estate sector represents a significant portion of the nation's economy, with urban centers like Lagos, Abuja, and Port Harcourt experiencing rapid development and substantial property investments. However, the legal framework governing real estate transactions in Nigeria contains numerous ambiguities and loopholes that continue to create challenges for investors, developers, and everyday citizens. This article examines these laws, their implementation challenges, and the various legal gaps that are often exploited."}],"markDefs":[],"style":"normal"},{"_key":"9c2ec3cbcb39","_type":"block","children":[{"_key":"e973885cc856","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"4ee1bbe08d37","_type":"block","children":[{"_key":"6bfe04c97286","_type":"span","marks":["strong"],"text":"Land Use Act: The Foundation with Fundamental Flaws"}],"markDefs":[],"style":"normal"},{"_key":"9a57d0f42784","_type":"block","children":[{"_key":"7459f0074969","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"89e3d2fedf97","_type":"block","children":[{"_key":"ecb5028c3840","_type":"span","marks":[],"text":"The Land Use Act of 1978 remains the cornerstone of Nigeria's real estate legal framework, vesting all land within a state's territory in the governor who holds it in trust for the people. While this law aimed to streamline land administration and make land more accessible, several loopholes have emerged over the decades:"}],"markDefs":[],"style":"normal"},{"_key":"241dfa26c6f2","_type":"block","children":[{"_key":"b348245f0384","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"1179d9cc8e7a","_type":"block","children":[{"_key":"86927200416b","_type":"span","marks":[],"text":"The Act requires governor's consent for any property transfer, creating bureaucratic bottlenecks that significantly delay legitimate transactions. This requirement has spawned an informal market of \"holding\" agreements where parties conduct transactions without officially transferring title—creating legal uncertainty and potential for future disputes."}],"markDefs":[],"style":"normal"},{"_key":"445f9c31e57b","_type":"block","children":[{"_key":"1bc194f2a53d","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"6a91d1157aa6","_type":"block","children":[{"_key":"185c31e12ce6","_type":"span","marks":[],"text":"Additionally, the Act's compensation provisions for land acquisition have proven inadequate, often failing to reflect market values. This discrepancy has led to widespread litigation and resistance to government acquisition projects, with savvy landowners exploiting procedural technicalities to demand higher compensation or delay development projects."}],"markDefs":[],"style":"normal"},{"_key":"e7e03f3c0cc4","_type":"block","children":[{"_key":"bd8491c113aa","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"8235d7dddb3f","_type":"block","children":[{"_key":"3442cd5379f6","_type":"span","marks":["strong"],"text":"Unclear Title Registration Systems"}],"markDefs":[],"style":"normal"},{"_key":"a0219d18cfdc","_type":"block","children":[{"_key":"19e7c2b8d7ca","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"4e302136a9b5","_type":"block","children":[{"_key":"e57a77f05f7a","_type":"span","marks":[],"text":"Nigeria's fragmented title registration system varies by state, creating inconsistencies that undermine security of tenure. In many states, multiple registries exist with overlapping jurisdictions, allowing unscrupulous individuals to:"}],"markDefs":[],"style":"normal"},{"_key":"b7b4a087e696","_type":"block","children":[{"_key":"9c25c1719c11","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"d7279bf6bad0","_type":"block","children":[{"_key":"0fe906dfb333","_type":"span","marks":[],"text":"- Register the same property multiple times across different systems"}],"markDefs":[],"style":"normal"},{"_key":"9591cc25a390","_type":"block","children":[{"_key":"ddb16f1fe90c","_type":"span","marks":[],"text":"- Create fraudulent documentation that appears legitimate"}],"markDefs":[],"style":"normal"},{"_key":"50a1d65d5c1a","_type":"block","children":[{"_key":"8526fe64d34d","_type":"span","marks":[],"text":"- Exploit gaps between customary land rights and statutory registration"}],"markDefs":[],"style":"normal"},{"_key":"13f15d0b264d","_type":"block","children":[{"_key":"cf2a9a2bd9db","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"f1e7b829767f","_type":"block","children":[{"_key":"1e572628ac08","_type":"span","marks":[],"text":"Lagos State's introduction of electronic Certificate of Occupancy (e-C of O) represents progress, but most states still operate manual systems vulnerable to manipulation and corruption. The lack of a unified national land registry system creates opportunities for double sales and title fraud."}],"markDefs":[],"style":"normal"},{"_key":"a6edf73c92ee","_type":"block","children":[{"_key":"d9b9f86dfc33","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"0061ac21057a","_type":"block","children":[{"_key":"8eed6b4abad2","_type":"span","marks":["strong"],"text":"Tenancy Law Enforcement Gaps"}],"markDefs":[],"style":"normal"},{"_key":"f61aa87144da","_type":"block","children":[{"_key":"3003a641ca33","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"95383d5ed05a","_type":"block","children":[{"_key":"3b10dba80aed","_type":"span","marks":[],"text":"Various states have enacted tenancy laws to regulate landlord-tenant relationships, but enforcement mechanisms remain weak. In Lagos, the Tenancy Law of 2011 prohibits landlords from collecting more than one year's rent in advance for residential properties. However, this provision is routinely violated due to:"}],"markDefs":[],"style":"normal"},{"_key":"bec1b40355ee","_type":"block","children":[{"_key":"8ca035ccaa4e","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"516fa1bf8da8","_type":"block","children":[{"_key":"fa644d6f523e","_type":"span","marks":[],"text":"- Insufficient monitoring mechanisms"}],"markDefs":[],"style":"normal"},{"_key":"f205a3385243","_type":"block","children":[{"_key":"a1878df6bdc6","_type":"span","marks":[],"text":"- Lack of penalties that effectively deter violations"}],"markDefs":[],"style":"normal"},{"_key":"5f111c556b00","_type":"block","children":[{"_key":"320c1b053e66","_type":"span","marks":[],"text":"- Market pressures that force tenants to accept illegal terms"}],"markDefs":[],"style":"normal"},{"_key":"d1f038c97d8c","_type":"block","children":[{"_key":"7addaee474be","_type":"span","marks":[],"text":"- Limited access to affordable legal remedies"}],"markDefs":[],"style":"normal"},{"_key":"4a37bd828dc5","_type":"block","children":[{"_key":"a3746ded8ce5","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"fed2008fb341","_type":"block","children":[{"_key":"45a05ba8ce85","_type":"span","marks":[],"text":"Landlords often circumvent these regulations by structuring agreements as \"service contracts\" rather than traditional leases, or by demanding substantial \"caution deposits\" that effectively function as additional rent payments."}],"markDefs":[],"style":"normal"},{"_key":"cc7c4d3bccb9","_type":"block","children":[{"_key":"025bf1abaabc","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"9bde3b1810ae","_type":"block","children":[{"_key":"5c3c6592f6b0","_type":"span","marks":["strong"],"text":"Mortgage and Foreclosure Challenges"}],"markDefs":[],"style":"normal"},{"_key":"d3ac439d8130","_type":"block","children":[{"_key":"44f9447d0b22","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"99db32ca2c39","_type":"block","children":[{"_key":"7d2afcf68e70","_type":"span","marks":[],"text":"Nigeria's mortgage laws contain significant ambiguities that impede the development of a robust mortgage market. The Mortgage Institutions Act and various state mortgage laws establish basic frameworks, but lenders face substantial challenges in enforcing security interests when borrowers default."}],"markDefs":[],"style":"normal"},{"_key":"9b9a0a91c8e8","_type":"block","children":[{"_key":"8c369386b56b","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"9a5d12d499d1","_type":"block","children":[{"_key":"87c9f3ccff1f","_type":"span","marks":[],"text":"Courts have frequently interpreted foreclosure provisions narrowly, requiring lenders to pursue lengthy judicial processes before recovering secured properties. This legal uncertainty contributes to Nigeria's high mortgage interest rates and stringent lending requirements, limiting access to housing finance."}],"markDefs":[],"style":"normal"},{"_key":"65e768d30d23","_type":"block","children":[{"_key":"571740280a50","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"e69a61e7ed10","_type":"block","children":[{"_key":"6ac6e4de53e3","_type":"span","marks":[],"text":"Savvy borrowers exploit procedural technicalities to delay foreclosure proceedings, sometimes for years, while continuing to occupy or derive income from the property. This legal maneuvering reduces the value of real estate as collateral and undermines the entire mortgage system."}],"markDefs":[],"style":"normal"},{"_key":"2a761e6c3614","_type":"block","children":[{"_key":"e93e808e378e","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"899c214d3235","_type":"block","children":[{"_key":"892d7e427943","_type":"span","marks":["strong"],"text":"Urban Planning and Development Control Loopholes"}],"markDefs":[],"style":"normal"},{"_key":"cea220070e00","_type":"block","children":[{"_key":"639cc2ddf464","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"c0db9bec0ef9","_type":"block","children":[{"_key":"3db9d2f8e464","_type":"span","marks":[],"text":"Nigeria's urban planning laws and building codes exist on paper but suffer from inconsistent enforcement. Developers routinely exploit several loopholes:"}],"markDefs":[],"style":"normal"},{"_key":"7d449b739d3b","_type":"block","children":[{"_key":"25c2f52f5383","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"3ec8cdb4a2e9","_type":"block","children":[{"_key":"4164bb55018e","_type":"span","marks":[],"text":"- Initiating construction without permits, then seeking retroactive approval"}],"markDefs":[],"style":"normal"},{"_key":"89406c19602b","_type":"block","children":[{"_key":"7e39a0caf0b3","_type":"span","marks":[],"text":"- Obtaining approvals for one purpose, then altering building use without authorization"}],"markDefs":[],"style":"normal"},{"_key":"2c6b8f7accc4","_type":"block","children":[{"_key":"762dd66a898a","_type":"span","marks":[],"text":"- Bribing enforcement officials to overlook violations"}],"markDefs":[],"style":"normal"},{"_key":"b603a7f61f23","_type":"block","children":[{"_key":"b0dc49ed8971","_type":"span","marks":[],"text":"- Exploiting jurisdictional conflicts between state and local authorities"}],"markDefs":[],"style":"normal"},{"_key":"12a881db7b23","_type":"block","children":[{"_key":"6946cec7b9e7","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"2cf1694ba991","_type":"block","children":[{"_key":"ead1f5e2ea9c","_type":"span","marks":[],"text":"These practices have led to haphazard development, unsafe structures, and infrastructure overload in many urban areas. Lagos State's demolition of illegal structures represents attempts at enforcement, but these efforts often come too late, after significant investments have already been made."}],"markDefs":[],"style":"normal"},{"_key":"12c1dd8b152a","_type":"block","children":[{"_key":"025900562e10","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"d2ff43ce6a9f","_type":"block","children":[{"_key":"b08d8f3081fc","_type":"span","marks":["strong"],"text":"Tax Evasion Through Real Estate"}],"markDefs":[],"style":"normal"},{"_key":"1c618a737b73","_type":"block","children":[{"_key":"c6bc49a55c67","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"7e247791ee98","_type":"block","children":[{"_key":"40f542f44f6e","_type":"span","marks":[],"text":"Nigeria's real estate sector serves as a significant avenue for tax evasion due to valuation ambiguities and enforcement challenges. Property values are frequently understated in official documentation to minimize:"}],"markDefs":[],"style":"normal"},{"_key":"af3cbb24d939","_type":"block","children":[{"_key":"18e9a69364dc","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"136f2bea3cd1","_type":"block","children":[{"_key":"155ed95135e2","_type":"span","marks":[],"text":"- Capital gains tax on property transfers"}],"markDefs":[],"style":"normal"},{"_key":"5cbc49692d87","_type":"block","children":[{"_key":"af8b29833345","_type":"span","marks":[],"text":"- Annual property taxes"}],"markDefs":[],"style":"normal"},{"_key":"92f9bd94dc20","_type":"block","children":[{"_key":"ee72b50158c4","_type":"span","marks":[],"text":"- Stamp duties on conveyancing documents"}],"markDefs":[],"style":"normal"},{"_key":"5b824bdc8552","_type":"block","children":[{"_key":"fcf5fc28e103","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"a385ae4655de","_type":"block","children":[{"_key":"39e36e135d03","_type":"span","marks":[],"text":"The absence of a comprehensive property valuation database makes it difficult for tax authorities to detect undervaluation. Additionally, many high-value properties are held through shell companies or nominees, obscuring beneficial ownership and complicating tax enforcement."}],"markDefs":[],"style":"normal"},{"_key":"de6d92b021c4","_type":"block","children":[{"_key":"1d49a5adc9d6","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"02fde8cebaa9","_type":"block","children":[{"_key":"e4da4cb69f85","_type":"span","marks":["strong"],"text":"Foreign Investment Restrictions and Workarounds"}],"markDefs":[],"style":"normal"},{"_key":"b7a52a3e3ebd","_type":"block","children":[{"_key":"283e1a07bed2","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"7d10340b588a","_type":"block","children":[{"_key":"208b4b03cd8f","_type":"span","marks":[],"text":"While Nigeria welcomes foreign investment in real estate, certain restrictions exist that are routinely circumvented. Foreign entities cannot directly acquire land but must establish Nigerian companies to do so. However, loopholes include:"}],"markDefs":[],"style":"normal"},{"_key":"9e9617a6ddb4","_type":"block","children":[{"_key":"61d9289538e7","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"d202f55ff033","_type":"block","children":[{"_key":"64afef960dec","_type":"span","marks":[],"text":"- Creating Nigerian shell companies with nominee directors"}],"markDefs":[],"style":"normal"},{"_key":"dc8aeafa7e84","_type":"block","children":[{"_key":"361da5e32caf","_type":"span","marks":[],"text":"- Utilizing irrevocable powers of attorney that effectively transfer control without changing title"}],"markDefs":[],"style":"normal"},{"_key":"d9d25bb57bdf","_type":"block","children":[{"_key":"3494df5e823b","_type":"span","marks":[],"text":"- Structuring investments as long-term leases rather than outright purchases"}],"markDefs":[],"style":"normal"},{"_key":"583905b94039","_type":"block","children":[{"_key":"4faab993eff7","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"8d0d4b61df83","_type":"block","children":[{"_key":"89e92217f208","_type":"span","marks":[],"text":"These arrangements create legal uncertainty and potential vulnerabilities for foreign investors, while also allowing circumvention of regulatory oversight designed to protect national interests."}],"markDefs":[],"style":"normal"},{"_key":"bbe9dc93a34f","_type":"block","children":[{"_key":"24f83f90c2ce","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"4bdfd0c29612","_type":"block","children":[{"_key":"38543abd83b2","_type":"span","marks":["strong"],"text":"Addressing the Gaps: Reform Initiatives"}],"markDefs":[],"style":"normal"},{"_key":"6b308f906a4d","_type":"block","children":[{"_key":"2766e60e0478","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"d1cdd0e0aac2","_type":"block","children":[{"_key":"ff0fc8e595fb","_type":"span","marks":[],"text":"Recent reform efforts have attempted to address these loopholes:"}],"markDefs":[],"style":"normal"},{"_key":"3693566b24c1","_type":"block","children":[{"_key":"d41cabcbee41","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"a527fe04366a","_type":"block","children":[{"_key":"8ed3c8af8160","_type":"span","marks":[],"text":"1. The proposed Land Use Act Amendment Bill seeks to streamline consent requirements and improve compensation frameworks"}],"markDefs":[],"style":"normal"},{"_key":"348105b90a7e","_type":"block","children":[{"_key":"558117e972b9","_type":"span","marks":[],"text":"2. The Foreclosure Law in Lagos aims to simplify mortgage enforcement procedures"}],"markDefs":[],"style":"normal"},{"_key":"861a72f560cc","_type":"block","children":[{"_key":"e83630cf61a3","_type":"span","marks":[],"text":"3. Digital land registries are being implemented in several states to reduce fraud"}],"markDefs":[],"style":"normal"},{"_key":"c7b0483cafab","_type":"block","children":[{"_key":"2d52bb80c46f","_type":"span","marks":[],"text":"4. Real Estate Developers Association of Nigeria (REDAN) Bill proposes regulation of developers to reduce fraudulent practices"}],"markDefs":[],"style":"normal"},{"_key":"a066115aa46a","_type":"block","children":[{"_key":"386d0ea1dbb2","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"ad3e9d228b26","_type":"block","children":[{"_key":"658125278dad","_type":"span","marks":[],"text":"However, these reforms face significant political and institutional resistance, as many powerful interests benefit from the status quo."}],"markDefs":[],"style":"normal"},{"_key":"74d631f7b519","_type":"block","children":[{"_key":"9e233c28c1bb","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"739c70ca3902","_type":"block","children":[{"_key":"99feb7cb7bc2","_type":"span","marks":["strong"],"text":"Conclusion"}],"markDefs":[],"style":"normal"},{"_key":"f5e8eed4ad43","_type":"block","children":[{"_key":"a0f024697223","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"98af38b2fe3f","_type":"block","children":[{"_key":"9484e7530221","_type":"span","marks":[],"text":"Nigeria's real estate laws contain numerous loopholes that undermine security of tenure, enable fraud, complicate financing, and frustrate urban planning efforts. While these gaps create opportunities for the well-connected and legally sophisticated, they impose substantial costs on the broader economy through reduced investment, higher transaction costs, and suboptimal land utilization."}],"markDefs":[],"style":"normal"},{"_key":"5604b15ac37d","_type":"block","children":[{"_key":"bad6d93a0a4c","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"cef90d3e5164","_type":"block","children":[{"_key":"1e8a82a859e4","_type":"span","marks":[],"text":"Comprehensive reform requires not just legislative changes but also institutional strengthening, technological modernization, and cultural shifts in how real estate transactions are conducted. Until such reforms are implemented, investors and participants in Nigeria's real estate market must navigate these legal gaps with careful due diligence and expert guidance to protect their interests."}],"markDefs":[],"style":"normal"}],"comments":[],"mainImage":{"_type":"image","alt":"real-estate-laws-and-their-loopholes-in-nigeria","asset":{"_ref":"image-4ddba50a538a27356325737eb9c696ca6552f4a1-9728x6656-jpg","_type":"reference"}},"title":"Real Estate Laws and Their Loopholes in Nigeria"}},"__N_SSG":true}}