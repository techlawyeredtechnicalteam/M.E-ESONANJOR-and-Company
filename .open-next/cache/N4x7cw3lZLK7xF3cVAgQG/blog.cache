script src=\"/_next/static/N4x7cw3lZLK7xF3cVAgQG/_ssgManifest.js\" defer=\"\"></script></head><body><link rel=\"preload\" as=\"image\" href=\"/logo.png\"/><div id=\"__next\"><div><header class=\"bg-gray-800 sticky top-0 z-20 text-white py-6 px-8 shadow-lg\"><div class=\"max-w-7xl mx-auto flex justify-between items-center\"><a class=\"flex items-center space-x-3\" href=\"/\"><img src=\"/logo.png\" alt=\"Honoredge Legal Practice Logo\" class=\"h-14 w-auto\"/></a><nav class=\"hidden md:flex space-x-8\"><a class=\"relative group font-semibold tracking-wide\" href=\"/about\">About<span class=\"absolute left-0 -bottom-1 w-0 h-0.5 bg-white transition-all group-hover:w-full\"></span></a><a class=\"relative group font-semibold tracking-wide\" href=\"/attorneys\">Attorneys<span class=\"absolute left-0 -bottom-1 w-0 h-0.5 bg-white transition-all group-hover:w-full\"></span></a><a class=\"relative group font-semibold tracking-wide\" href=\"/#practice-areas\">Practice Areas<span class=\"absolute left-0 -bottom-1 w-0 h-0.5 bg-white transition-all group-hover:w-full\"></span></a><a class=\"relative group font-semibold tracking-wide\" href=\"/blog\">Blog<span class=\"absolute left-0 -bottom-1 w-0 h-0.5 bg-white transition-all group-hover:w-full\"></span></a><a class=\"relative group font-semibold tracking-wide\" href=\"/contact\">Contact<span class=\"absolute left-0 -bottom-1 w-0 h-0.5 bg-white transition-all group-hover:w-full\"></span></a></nav><button class=\"md:hidden text-white focus:outline-none\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu\" aria-hidden=\"true\"><line x1=\"4\" x2=\"20\" y1=\"12\" y2=\"12\"></line><line x1=\"4\" x2=\"20\" y1=\"6\" y2=\"6\"></line><line x1=\"4\" x2=\"20\" y1=\"18\" y2=\"18\"></line></svg></button></div></header><main><div class=\"max-w-5xl mx-auto px-4 py-8\"><h1 class=\"text-3xl font-bold mb-8\">Blog Posts</h1><div class=\"space-y-10\"><div class=\"flex flex-col md:flex-row gap-4 bg-white shadow-md rounded-md p-4\"><div class=\"md:w-1/3 w-full\"><img alt=\"The Technological Advancements of Construction Law in Nigeria  \" loading=\"lazy\" width=\"400\" height=\"250\" decoding=\"async\" data-nimg=\"1\" class=\"rounded-md object-cover w-full h-full\" style=\"color:transparent\" srcSet=\"/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F7h99z6jk%2Fproduction%2Fe9e764ece50b3f8092b492d1fc89621f1db3000e-5376x3584.jpg&amp;w=640&amp;q=75 1x, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F7h99z6jk%2Fproduction%2Fe9e764ece50b3f8092b492d1fc89621f1db3000e-5376x3584.jpg&amp;w=828&amp;q=75 2x\" src=\"/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F7h99z6jk%2Fproduction%2Fe9e764ece50b3f8092b492d1fc89621f1db3000e-5376x3584.jpg&amp;w=828&amp;q=75\"/></div><div class=\"md:w-2/3 w-full flex flex-col justify-between\"><div><a href=\"/blog/the-technological-advancements-of-construction-law-in-nigeria\"><h2 class=\"text-2xl font-semibold text-gray-800 hover:text-blue-600\">The Technological Advancements of Construction Law in Nigeria  </h2></a><div class=\"flex items-center text-sm text-gray-600 mt-2 space-x-4\"><span class=\"flex items-center space-x-1\"><svg stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" viewBox=\"0 0 448 512\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M224 256c70.7 0 128-57.3 128-128S294.7 0 224 0 96 57.3 96 128s57.3 128 128 128zm89.6 32h-16.7c-22.2 10.2-46.9 16-72.9 16s-50.6-5.8-72.9-16h-16.7C60.2 288 0 348.2 0 422.4V464c0 26.5 21.5 48 48 48h352c26.5 0 48-21.5 48-48v-41.6c0-74.2-60.2-134.4-134.4-134.4z\"></path></svg><span>Ebuzhafe Annora Ogunsanya</span></span><span class=\"flex items-center space-x-1\"><svg stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" viewBox=\"0 0 576 512\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/20